@page "/"
@page "/statistics"
@using Kairos.Application.Services
@using Kairos.Application.Resources
@using System.Globalization
@using System.Text.Json
@inject ITimeTrackingService TimeService
@inject IStatisticsService StatisticsService
@inject ISettingsService SettingsService
@inject IBudgetSettingsService BudgetSettingsService
@inject INotificationService NotificationService
@inject IStorageService StorageService
@inject IStringLocalizer<Strings> Localizer

<div class="statistics-page">
    <div class="page-header">
        <h2 class="page-title">@Localizer["NavBudgets"]</h2>
        <div style="display: flex; gap: var(--spacing-md); align-items: center;">
            <div class="view-toggle">
                <button class="@(_budgetSortMode == BudgetSortMode.TrackedTime ? "active" : "")" @onclick="() => SetBudgetSortModeAsync(BudgetSortMode.TrackedTime)">@Localizer["SortByTrackedTime"]</button>
                <button class="@(_budgetSortMode == BudgetSortMode.BudgetUsage ? "active" : "")" @onclick="() => SetBudgetSortModeAsync(BudgetSortMode.BudgetUsage)">@Localizer["SortByBudgetUsage"]</button>
            </div>
        </div>
    </div>

    <div class="stat-summary-card">
        <div class="stat-label">
            @CurrentBudgetTypeLabel
        </div>
        <div class="stat-big-value" style="text-shadow: none; font-size: var(--font-size-lg);">
            @CurrentPeriodStartLabel - @CurrentPeriodEndLabel
        </div>
    </div>

    <!-- Budgets List -->
    <div class="budgets-section">
        <div class="budgets-list">
            @foreach (var activity in GetSortedActivities())
            {
                var tracked = GetTrackedTimeForActivity(activity.Name);
                var budget = GetBudgetForActivity(activity.Id);
                var hasBudget = budget != null && budget.AllocatedTimeSpan.TotalSeconds > 0 && SettingsService.BudgetsEnabled;
                var progress = hasBudget
                    ? Math.Min(100, (tracked.TotalHours / budget!.AllocatedTimeSpan.TotalHours) * 100)
                    : 0;
                var isOver = progress >= 100 && SettingsService.BudgetsEnabled;

                <div class="budget-item" style="@GetBudgetItemStyle(activity.Color)">
                    <div class="budget-item-header">
                        <span class="budget-activity-name">
                            <span class="activity-color-dot small" style="@GetColorDotStyle(activity.Color)"></span>
                            @activity.Emoji @activity.Name
                        </span>
                        <span class="budget-time @(isOver ? "over" : "")">
                            @tracked.TotalHours.ToString("F1")@Localizer["UnitHourShort"]
                            @if (hasBudget)
                            {
                                <span class="budget-of"> / @budget!.AllocatedTimeSpan.TotalHours.ToString("F0")@Localizer["UnitHourShort"]</span>
                            }
                        </span>
                    </div>
                    @if (hasBudget)
                    {
                        var minimumHours = budget!.MinimumTimeSpan.TotalHours;
                        var minimumProgress = (minimumHours > 0 && budget!.AllocatedTimeSpan.TotalHours > 0)
                            ? Math.Min(100, minimumHours / budget!.AllocatedTimeSpan.TotalHours * 100)
                            : 0.0;
                        var thresholdProgress = BudgetSettingsService.Threshold;
                        var periodDuration = (EndDate - StartDate).TotalHours;
                        var elapsedDuration = (DateTimeOffset.UtcNow - StartDate).TotalHours;
                        var expectedProgress = Math.Clamp((elapsedDuration / periodDuration) * 100, 0, 100);
                        <div class="budget-progress-track">
                            <div class="budget-progress-fill @(isOver ? "over" : "")" style="@GetBudgetProgressStyle(progress, isOver, tracked.TotalHours, minimumHours)"></div>
                            @if (BudgetSettingsService.MinimumEnabled && minimumProgress > 0)
                            {
                                <div class="budget-minimum-marker" style="left: @(minimumProgress.ToString("F2", CultureInfo.InvariantCulture))%; background: @BudgetSettingsService.ColorMinimumNotReached;"></div>
                            }
                            @if (thresholdProgress > 0 && thresholdProgress < 100)
                            {
                                <div class="budget-threshold-marker" style="left: @(thresholdProgress.ToString("F2", CultureInfo.InvariantCulture))%; background: @BudgetSettingsService.ColorBetweenThresholdMax;"></div>
                            }
                            @if (expectedProgress > 0 && expectedProgress < 100)
                            {
                                <div class="budget-expected-marker" style="left: @(expectedProgress.ToString("F2", CultureInfo.InvariantCulture))%"></div>
                            }
                            <div class="budget-max-marker" style="left: 100%; background: @BudgetSettingsService.ColorOverMax;"></div>
                        </div>
                    }

                    @if (SettingsService.BudgetsEnabled)
                    {
                        <button class="budget-edit-btn" @onclick="() => EditBudget(activity.Id)">@Localizer["SetBudget"]</button>
                    }
                </div>
            }
        </div>
    </div>
</div>

@if (IsEditingBudget)
{
    <div class="modal-overlay" @onclick="CancelEdit">
        <div class="modal-dialog" @onclick:stopPropagation="true">
            <h3>@string.Format(Localizer["BudgetFor"], EditingActivityName)</h3>
            <p>@($"{Localizer["BudgetSettingsBudgetType"].Value}: {CurrentBudgetTypeLabel}")</p>
            <div class="edit-form">
                @if (BudgetSettingsService.MinimumEnabled)
                {
                    <div class="edit-field">
                        <label class="edit-label">@Localizer["BudgetSettingsMinHours"]</label>
                        <input type="number" class="edit-input" @bind="EditingMinimumHours" min="0" max="@EditingBudgetHours" step="1" />
                    </div>
                }
                @if (BudgetSettingsService.Threshold > 0)
                {
                    <div class="edit-field">
                        <label class="edit-label">@($"{Localizer["BudgetSettingsThreshold"]} ({BudgetSettingsService.Threshold}%)")</label>
                        <div class="edit-input-readonly">@CalculatedThresholdHours.ToString("F1")</div>
                    </div>
                }
                <div class="edit-field">
                    <label class="edit-label">@Localizer["BudgetSettingsMaxHours"]</label>
                    <input type="number" class="edit-input" @ref="_budgetInputRef" @bind="EditingBudgetHours" min="@EditingMinimumHours" step="1" />
                </div>
            </div>
            <div class="modal-actions">
                <button class="btn-cancel" @onclick="CancelEdit">@Localizer["Cancel"]</button>
                <button class="btn-save" @onclick="SaveBudget">@Localizer["Save"]</button>
            </div>
        </div>
    </div>
}


@code {
    private enum BudgetSortMode { TrackedTime, BudgetUsage }
    private BudgetSortMode _budgetSortMode = BudgetSortMode.BudgetUsage;

    private IEnumerable<Kairos.Core.Models.Activity> GetSortedActivities() => _budgetSortMode switch
    {
        BudgetSortMode.TrackedTime => TimeService.Account.Activities
            .OrderByDescending(a => GetTrackedTimeForActivity(a.Name)),
        _ => TimeService.Account.Activities
            .OrderByDescending(a =>
            {
                var b = GetBudgetForActivity(a.Id);
                if (b == null || b.AllocatedTimeSpan.TotalSeconds <= 0 || !SettingsService.BudgetsEnabled)
                    return -1.0;
                return GetTrackedTimeForActivity(a.Name).TotalHours / b.AllocatedTimeSpan.TotalHours;
            })
    };

    private List<ActivityBudget> _currentBudgets = new();
    private bool IsEditingBudget = false;
    private Guid EditingActivityId;
    private string EditingActivityName = "";
    private double _editingBudgetHours = 0;
    private double EditingBudgetHours
    {
        get => _editingBudgetHours;
        set
        {
            _editingBudgetHours = Math.Max(0, value);
            if (EditingMinimumHours > _editingBudgetHours)
            {
                EditingMinimumHours = _editingBudgetHours;
            }
        }
    }

    private double _editingMinimumHours = 0;
    private double EditingMinimumHours
    {
        get => _editingMinimumHours;
        set => _editingMinimumHours = Math.Max(0, Math.Min(value, EditingBudgetHours));
    }
    private double CalculatedThresholdHours => Math.Round(EditingBudgetHours * (BudgetSettingsService.Threshold / 100.0), 1);
    private ElementReference _budgetInputRef;
    private bool _budgetFocusRequested;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_budgetFocusRequested && IsEditingBudget)
        {
            _budgetFocusRequested = false;
            try
            {
                await _budgetInputRef.FocusAsync();
            }
            catch
            {
                // Ignore focus errors (e.g., element not visible yet)
            }
        }
    }

    protected override async Task OnInitializedAsync()
    {
        TimeService.OnStateChanged += StateHasChanged;
        SettingsService.OnSettingsChanged += StateHasChanged;
        BudgetSettingsService.OnSettingsChanged += HandleBudgetSettingsChanged;
        await LoadBudgetSortModeAsync();
        RefreshTimelineData();
        await LoadBudgetsAsync();
        await LoadBudgetNotificationStateAsync();
        
        // Refresh every 5 seconds
        _timer = new System.Threading.Timer(_ =>
        {
            InvokeAsync(async () =>
            {
                RefreshTimelineData();
                await CheckBudgetNotificationsAsync();
                StateHasChanged();
            });
        }, null, TimeSpan.FromSeconds(5), TimeSpan.FromSeconds(5));
    }

    private async Task LoadBudgetsAsync()
    {
        var currentType = BudgetSettingsService.BudgetType;
        
        _currentBudgets.Clear();
        foreach (var act in TimeService.Account.Activities)
        {
            var b = await StatisticsService.GetBudgetAsync(act.Id, currentType);
            if (b != null) _currentBudgets.Add(b);
        }
    }
    
    private DateTimeOffset StartDate => BudgetSettingsService.BudgetType switch
    {
        BudgetType.Daily => new DateTimeOffset(DateTimeOffset.UtcNow.Date, TimeSpan.Zero),
        BudgetType.Weekly => DateTimeOffset.UtcNow.AddDays(-(int)DateTimeOffset.UtcNow.DayOfWeek + 1).Date, // Monday of this week
        _ => new DateTimeOffset(DateTimeOffset.UtcNow.Year, DateTimeOffset.UtcNow.Month, 1, 0, 0, 0, TimeSpan.Zero)
    };
        
    private DateTimeOffset EndDate => BudgetSettingsService.BudgetType switch
    {
        BudgetType.Daily => StartDate.AddDays(1),
        BudgetType.Weekly => StartDate.AddDays(7),
        _ => StartDate.AddMonths(1)
    };

    private string PeriodLabel => BudgetSettingsService.BudgetType switch
    {
        BudgetType.Daily => Localizer["Today"].Value,
        BudgetType.Weekly => Localizer["ThisWeek"].Value,
        _ => Localizer["ThisMonth"].Value
    };

    private string CurrentBudgetTypeLabel => BudgetSettingsService.BudgetType switch
    {
        BudgetType.Daily => Localizer["BudgetSettingsBudgetTypeDaily"].Value,
        BudgetType.Weekly => Localizer["BudgetSettingsBudgetTypeWeekly"].Value,
        _ => Localizer["BudgetSettingsBudgetTypeMonthly"].Value
    };

    private string CurrentPeriodStartLabel => StartDate.ToLocalTime().ToString("yyyy-MM-dd", CultureInfo.InvariantCulture);
    private string CurrentPeriodEndLabel => EndDate.AddTicks(-1).ToLocalTime().ToString("yyyy-MM-dd", CultureInfo.InvariantCulture);

    private TimeSpan TotalTime
    {
        get
        {
            var events = TimeService.Account.Events
                .Where(e => (e.StartTime >= StartDate && e.StartTime < EndDate) || 
                            (e.EndTime.HasValue && e.EndTime >= StartDate && e.EndTime < EndDate) ||
                            (e.StartTime < StartDate && (!e.EndTime.HasValue || e.EndTime > EndDate)))
                .ToList();

            double totalHours = 0;
            foreach (var e in events)
            {
                var start = e.StartTime > StartDate ? e.StartTime : StartDate;
                var end = (e.EndTime ?? DateTimeOffset.UtcNow) < EndDate ? (e.EndTime ?? DateTimeOffset.UtcNow) : EndDate;
                if (end > start)
                {
                    totalHours += (end - start).TotalHours;
                }
            }
            return TimeSpan.FromHours(totalHours);
        }
    }

    private TimeSpan GetTrackedTimeForActivity(string activityName)
    {
        var events = TimeService.Account.Events
            .Where(e => e.ActivityName == activityName &&
                        ((e.StartTime >= StartDate && e.StartTime < EndDate) || 
                        (e.EndTime.HasValue && e.EndTime >= StartDate && e.EndTime < EndDate) ||
                        (e.StartTime < StartDate && (!e.EndTime.HasValue || e.EndTime > EndDate))))
            .ToList();

        double totalHours = 0;
        foreach (var e in events)
        {
            var start = e.StartTime > StartDate ? e.StartTime : StartDate;
            var end = (e.EndTime ?? DateTimeOffset.UtcNow) < EndDate ? (e.EndTime ?? DateTimeOffset.UtcNow) : EndDate;
            if (end > start)
            {
                totalHours += (end - start).TotalHours;
            }
        }
        return TimeSpan.FromHours(totalHours);
    }

    private ActivityBudget? GetBudgetForActivity(Guid activityId)
    {
        return _currentBudgets.FirstOrDefault(b => b.ActivityId == activityId);
    }

    private void EditBudget(Guid activityId)
    {
        var activity = TimeService.Account.Activities.FirstOrDefault(a => a.Id == activityId);
        if (activity == null) return;
        
        EditingActivityId = activityId;
        EditingActivityName = activity.Name;
        var budget = GetBudgetForActivity(activityId);
        EditingBudgetHours = budget?.AllocatedTimeSpan.TotalHours ?? 0;
        EditingMinimumHours = budget?.MinimumTimeSpan.TotalHours ?? 0;
        IsEditingBudget = true;
        _budgetFocusRequested = true;
    }

    private async Task SaveBudget()
    {
        var currentType = BudgetSettingsService.BudgetType;

        var budget = GetBudgetForActivity(EditingActivityId) ?? new ActivityBudget 
        { 
            ActivityId = EditingActivityId,
            Type = currentType
        };
        
        budget.AllocatedTimeSpan = TimeSpan.FromHours(EditingBudgetHours);
        budget.MinimumTimeSpan = TimeSpan.FromHours(EditingMinimumHours);

        await StatisticsService.SaveBudgetAsync(budget);
        
        IsEditingBudget = false;
        await LoadBudgetsAsync();
    }

    private void CancelEdit()
    {
        IsEditingBudget = false;
    }

    private void HandleBudgetSettingsChanged()
    {
        _ = InvokeAsync(async () =>
        {
            await LoadBudgetsAsync();
            RefreshTimelineData();
            StateHasChanged();
        });
    }

    public void Dispose()
    {
        TimeService.OnStateChanged -= StateHasChanged;
        SettingsService.OnSettingsChanged -= StateHasChanged;
        BudgetSettingsService.OnSettingsChanged -= HandleBudgetSettingsChanged;
        _timer?.Dispose();
    }

    private async Task CheckBudgetNotificationsAsync()
    {
        if (!BudgetSettingsService.NotificationsEnabled || !SettingsService.BudgetsEnabled)
            return;

        // Load state for new period when the period rolls over
        if (StartDate != _lastKnownPeriodStart)
        {
            _notifiedBudgetStates.Clear();
            _lastKnownPeriodStart = StartDate;
            await LoadBudgetNotificationStateAsync();
        }

        foreach (var activity in TimeService.Account.Activities)
        {
            var budget = GetBudgetForActivity(activity.Id);
            if (budget == null || budget.AllocatedTimeSpan.TotalSeconds <= 0)
                continue;

            var tracked = GetTrackedTimeForActivity(activity.Name);
            var progress = (tracked.TotalHours / budget.AllocatedTimeSpan.TotalHours) * 100;
            var minimumHours = budget.MinimumTimeSpan.TotalHours;

            if (!_notifiedBudgetStates.TryGetValue(activity.Id, out var fired))
            {
                fired = new HashSet<string>();
                _notifiedBudgetStates[activity.Id] = fired;
            }

            if (progress >= 100 && fired.Add("max"))
            {
                await NotificationService.NotifyAsync(
                    Localizer["NotificationBudgetMaxReachedTitle"].Value,
                    string.Format(Localizer["NotificationBudgetMaxReachedBody"].Value, activity.Name));
                await SaveBudgetNotificationStateAsync();
            }
            else if (BudgetSettingsService.Threshold > 0 && progress >= BudgetSettingsService.Threshold && fired.Add("threshold"))
            {
                await NotificationService.NotifyAsync(
                    Localizer["NotificationBudgetThresholdReachedTitle"].Value,
                    string.Format(Localizer["NotificationBudgetThresholdReachedBody"].Value, activity.Name, BudgetSettingsService.Threshold));
                await SaveBudgetNotificationStateAsync();
            }

            if (BudgetSettingsService.MinimumEnabled && minimumHours > 0 && tracked.TotalHours >= minimumHours && fired.Add("min"))
            {
                await NotificationService.NotifyAsync(
                    Localizer["NotificationBudgetMinReachedTitle"].Value,
                    string.Format(Localizer["NotificationBudgetMinReachedBody"].Value, activity.Name));
                await SaveBudgetNotificationStateAsync();
            }
        }
    }

    private async Task LoadBudgetNotificationStateAsync()
    {
        var json = await StorageService.GetItemAsync(BudgetNotificationStorageKey);
        if (string.IsNullOrEmpty(json)) return;
        try
        {
            var stored = JsonSerializer.Deserialize<Dictionary<string, List<string>>>(json);
            if (stored == null) return;
            foreach (var (key, values) in stored)
            {
                if (Guid.TryParse(key, out var id))
                    _notifiedBudgetStates[id] = new HashSet<string>(values);
            }
        }
        catch { /* ignore corrupt storage */ }
    }

    private async Task SaveBudgetNotificationStateAsync()
    {
        var serializable = _notifiedBudgetStates
            .ToDictionary(kv => kv.Key.ToString(), kv => kv.Value.ToList());
        await StorageService.SetItemAsync(BudgetNotificationStorageKey, JsonSerializer.Serialize(serializable));
    }

    private async Task SetBudgetSortModeAsync(BudgetSortMode sortMode)
    {
        _budgetSortMode = sortMode;
        await StorageService.SetItemAsync(BudgetSortStorageKey, sortMode.ToString());
    }

    private async Task LoadBudgetSortModeAsync()
    {
        var value = await StorageService.GetItemAsync(BudgetSortStorageKey);
        if (string.IsNullOrWhiteSpace(value))
        {
            return;
        }

        if (Enum.TryParse<BudgetSortMode>(value, ignoreCase: true, out var parsedSortMode))
        {
            _budgetSortMode = parsedSortMode;
        }
    }

    // --- Timeline Chart Logic ---
    private List<TimelineDataPoint> DataPoints { get; set; } = new();
    
    private double MinY => 0;
    private double MaxY => DataPoints.Count > 0 ? Math.Max(0, DataPoints.Max(p => p.BalanceHours)) : 1;
    private System.Threading.Timer? _timer;

    // Tracks which budget notification types have already fired per activity in the current period
    private readonly Dictionary<Guid, HashSet<string>> _notifiedBudgetStates = new();
    private DateTimeOffset _lastKnownPeriodStart = DateTimeOffset.MinValue;
    private const string BudgetSortStorageKey = "Kairos_budgetSortMode";

    private string BudgetNotificationStorageKey =>
        $"Kairos_budgetNotifications_{StartDate.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture)}";

    private void RefreshTimelineData()
    {
        DataPoints = TimeService.GetTimelineData(StartDate, EndDate);
    }

    private double GetXFromTimestamp(DateTimeOffset timestamp)
    {
        var totalTicks = (EndDate - StartDate).Ticks;
        if (totalTicks == 0) return 400;
        
        var positionTicks = (timestamp - StartDate).Ticks;
        var ratio = (double)positionTicks / totalTicks;
        
        // Clamp to chart bounds [0, 1]
        ratio = Math.Clamp(ratio, 0.0, 1.0);
        
        // Map to chart X coordinates (50 to 750)
        return 50 + ratio * 700;
    }

    private double GetY(double value)
    {
        var range = MaxY - MinY;
        if (range == 0) range = 1;
        var normalized = (MaxY - value) / range;
        return 50 + normalized * 300;
    }


    private string FormatTimeLabel(DateTime time)
    {
        var period = EndDate - StartDate;
        if (period.TotalHours <= 24)
        {
            return time.ToString("HH:mm");
        }
        else
        {
            return time.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture);
        }
    }

    private static string GetBudgetItemStyle(string color)
    {
        var normalized = Activity.SanitizeColor(color);
        return $"border-color: {ToRgba(normalized, 0.24)};";
    }

    private string GetBudgetProgressStyle(double progress, bool isOver, double trackedHours, double minimumHours)
    {
        string color;
        if (isOver)
            color = Activity.SanitizeColor(BudgetSettingsService.ColorOverMax);
        else if (progress >= BudgetSettingsService.Threshold)
            color = Activity.SanitizeColor(BudgetSettingsService.ColorBetweenThresholdMax);
        else if (BudgetSettingsService.MinimumEnabled && minimumHours > 0 && trackedHours < minimumHours)
            color = Activity.SanitizeColor(BudgetSettingsService.ColorMinimumNotReached);
        else
            color = Activity.SanitizeColor(BudgetSettingsService.ColorMinimumReachedMaxNotReached);
        return $"width: {progress.ToString(CultureInfo.InvariantCulture)}%; background: {color};";
    }

    private static string GetColorDotStyle(string color)
    {
        var normalized = Activity.SanitizeColor(color);
        return $"background: {normalized}; box-shadow: 0 0 0 4px {ToRgba(normalized, 0.16)};";
    }

    private static string ToRgba(string color, double alpha)
    {
        var normalized = Activity.SanitizeColor(color);
        var red = Convert.ToInt32(normalized.Substring(1, 2), 16);
        var green = Convert.ToInt32(normalized.Substring(3, 2), 16);
        var blue = Convert.ToInt32(normalized.Substring(5, 2), 16);
        return $"rgba({red}, {green}, {blue}, {alpha.ToString(CultureInfo.InvariantCulture)})";
    }
}
