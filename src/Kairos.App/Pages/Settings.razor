    private void OnAutoDeleteEventDurationChanged(ChangeEventArgs e)
    {
        var input = e.Value?.ToString();

        // Ensure input is a valid integer between 0 and 999 and contains no decimals or signs
        if (int.TryParse(input, out int duration) && duration >= 0 && duration <= 999 && !input!.Contains(".") && !input.Contains(",") && !input.Contains("+") && !input.Contains("-"))
        {
            isAutoDeleteInvalid = false;
            SettingsService.AutoDeleteEventDuration = duration;
        }
        else
        {
            isAutoDeleteInvalid = true;
        }
    }

    private void OnStickyEventsDurationChanged(ChangeEventArgs e)
    {
        var input = e.Value?.ToString();

        // Ensure input is a valid integer between 0 and 999 and contains no decimals or signs
        if (int.TryParse(input, out int duration) && duration >= 0 && duration <= 999 && !input!.Contains(".") && !input.Contains(",") && !input.Contains("+") && !input.Contains("-"))
        {
            isStickyEventsInvalid = false;
            SettingsService.StickyEventsDuration = duration;
        }
        else
        {
            isStickyEventsInvalid = true;
        }
    }

