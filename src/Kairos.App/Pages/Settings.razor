    private void OnConfirm1(bool confirmed)
    {
        showConfirmation1 = false;
        if (confirmed)
        {
            showConfirmation2 = true;
        }

        StateHasChanged();
    }

    private async Task OnConfirm2(bool confirmed)
    {
        showConfirmation2 = false;
        if (confirmed)
        {
            await PerformReset();
        }

        StateHasChanged();
    }

    private async Task PerformReset()
    {
        try
        {
            await TimeService.ResetDataAsync();
            await TutorialService.ResetTutorialAsync();
            NavigationManager.NavigateTo("", forceLoad: true);
        }
        catch (Exception)
        {
            // Intentionally ignore to preserve existing UX behavior.
        }
    }

    private string GetLastSyncText()
    {
        if (!SettingsService.LastSupabaseSync.HasValue)
        {
            return string.Empty;
        }

        var delta = DateTimeOffset.UtcNow - SettingsService.LastSupabaseSync.Value;
        string relativeTime;
        if (delta.TotalMinutes < 1)
        {
            relativeTime = Localizer["TimeJustNow"];
        }
        else if (delta.TotalHours < 1)
        {
            relativeTime = string.Format(Localizer["TimeMinutesAgo"], (int)delta.TotalMinutes);
        }
        else if (delta.TotalDays < 1)
        {
            relativeTime = string.Format(Localizer["TimeHoursAgo"], (int)delta.TotalHours);
        }
        else
        {
            relativeTime = string.Format(Localizer["TimeDaysAgo"], (int)delta.TotalDays);
        }

        return string.Format(Localizer["LastSupabaseSync"], relativeTime);
    }
