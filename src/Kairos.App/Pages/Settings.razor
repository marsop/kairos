@page "/settings"
@using Kairos.Application.Services
@using Microsoft.JSInterop
@inject ISettingsService SettingsService
@inject NavigationManager NavigationManager
@inject IStringLocalizer<Strings> Localizer
@inject ITimeTrackingService TimeService
@inject ITutorialService TutorialService
@inject IJSRuntime JSRuntime
@inject ITimeularService TimeularService
@inject IBudgetSettingsService BudgetSettingsService
@inject INotificationService NotificationService
@inject ISupabaseAuthService AuthService
@implements IDisposable
@using System.Reflection
@using Kairos.Core.Models

<div class="settings-page">
    <h1 class="page-title">@Localizer["NavSettings"]</h1>

    <div class="settings-section">
        <h2 class="section-title">⚙️ @Localizer["SettingsGeneral"]</h2>
        <div class="setting-item compact no-border">
            <span class="setting-label">@Localizer["DisplayLanguage"]</span>
            <div class="language-dropdown">
                <button type="button" class="dropdown-trigger" @onclick="ToggleDropdown">
                    <span class="flag-icon">@GetFlag(SelectedLanguage)</span>
                    <span>@GetLanguageName(SelectedLanguage)</span>
                </button>
                <div class="dropdown-menu @(isDropdownOpen ? "show" : "")">
                    @foreach (var lang in Languages)
                    {
                        <div class="dropdown-item @(SelectedLanguage == lang.Code ? "selected" : "")"
                             @onclick="() => SelectLanguage(lang.Code)"
                             @onclick:stopPropagation="true">
                            <span class="flag-icon">@lang.Flag</span>
                            <span>@lang.Name</span>
                        </div>
                    }
                </div>
            </div>
        </div>

        <div class="setting-item compact no-border">
            <span class="setting-label">@Localizer["Theme"]</span>
            <div class="language-dropdown">
                <button type="button" class="dropdown-trigger" @onclick="ToggleThemeDropdown">
                    <span class="theme-icon">@GetThemeIcon(SelectedTheme)</span>
                    <span>@GetThemeName(SelectedTheme)</span>
                </button>
                <div class="dropdown-menu @(isThemeDropdownOpen ? "show" : "")">
                    @foreach (var theme in Themes)
                    {
                        <div class="dropdown-item @(SelectedTheme == theme.Code ? "selected" : "")"
                             @onclick="() => SelectTheme(theme.Code)"
                             @onclick:stopPropagation="true">
                            <span class="theme-icon">@theme.Icon</span>
                            <span>@Localizer[theme.LabelKey]</span>
                        </div>
                    }
                </div>
            </div>
        </div>

        <div class="setting-item compact">
            <span class="setting-label">@Localizer["TutorialAvatar"]</span>
            <div class="language-dropdown">
                <button type="button" class="dropdown-trigger" @onclick="ToggleAvatarDropdown">
                    <span class="avatar-icon"><img src="@($"{TutorialService.CurrentAvatar?.BasePath}/tutorial-avatar.png")" alt="avatar icon" /></span>
                    <span>@SelectedAvatarName</span>
                </button>
                <div class="dropdown-menu @(isAvatarDropdownOpen ? "show" : "")">
                    @foreach (var avatar in TutorialService.AvailableAvatars)
                    {
                        <div class="dropdown-item @(TutorialService.CurrentAvatar?.Id == avatar.Id ? "selected" : "")"
                             @onclick="() => SelectAvatar(avatar.Id)"
                             @onclick:stopPropagation="true">
                            <span class="avatar-icon"><img src="@($"{avatar.BasePath}/tutorial-avatar.png")" alt="avatar icon" /></span>
                            <span>@avatar.Name</span>
                        </div>
                    }
                </div>
            </div>
        </div>

        <div class="setting-item">
            <div>
                <span class="setting-label">@Localizer["BrowserNotifications"]</span>
                <span class="setting-description" style="display: block; margin-top: 2px;">@Localizer["BrowserNotificationsDesc"]</span>
            </div>
            <label class="toggle-switch">
                <input type="checkbox" checked="@SettingsService.BrowserNotificationsEnabled" @onchange="OnBrowserNotificationsToggled" />
                <span class="toggle-slider"></span>
            </label>
        </div>

        @if (browserNotificationsDenied)
        {
            <div class="status-message error" style="margin-top: var(--spacing-sm);">
                @Localizer["BrowserNotificationsDenied"]
            </div>
        }

        <div class="setting-item">
            <div>
                <span class="setting-label">@Localizer["Sounds"]</span>
                <span class="setting-description" style="display: block; margin-top: 2px;">@Localizer["SoundsDesc"]</span>
            </div>
            <label class="toggle-switch">
                <input type="checkbox" checked="@SettingsService.SoundsEnabled" @onchange="OnSoundsToggled" />
                <span class="toggle-slider"></span>
            </label>
        </div>

        <div class="setting-item">
            <div>
                <span class="setting-label">@Localizer["ShowAdvancedSettings"]</span>
            </div>
            <label class="toggle-switch">
                <input type="checkbox" checked="@SettingsService.AdvancedSettingsEnabled" @onchange="OnAdvancedSettingsToggled" />
                <span class="toggle-slider"></span>
            </label>
        </div>
    </div>

    @if (SettingsService.AdvancedSettingsEnabled)
    {
        <div class="settings-section">
            <h2 class="section-title">🔐 @Localizer["SettingsAdvanced"]</h2>

        <div class="setting-item">
            <div>
                <span class="setting-label">@Localizer["ShowTimeularSettings"]</span>
                <span class="setting-description" style="display: block; margin-top: 2px;">@Localizer["ShowTimeularSettingsDesc"]</span>
            </div>
            <label class="toggle-switch">
                <input type="checkbox" checked="@SettingsService.TimeularSettingsEnabled" @onchange="OnTimeularSettingsToggled" />
                <span class="toggle-slider"></span>
            </label>
        </div>

        <div class="setting-item">
            <div>
                <span class="setting-label">@Localizer["ActivityGroups"]</span>
                <span class="setting-description" style="display: block; margin-top: 2px;">@Localizer["ActivityGroupsDesc"]</span>
            </div>
            <label class="toggle-switch">
                <input type="checkbox" checked="@SettingsService.ActivityGroupsEnabled" @onchange="OnActivityGroupsToggled" />
                <span class="toggle-slider"></span>
            </label>
        </div>

        <div class="setting-item">
            <div>
                <span class="setting-label">@Localizer["EnableBudgets"]</span>
                <span class="setting-description" style="display: block; margin-top: 2px;">@Localizer["EnableBudgetsDesc"]</span>
            </div>
            <label class="toggle-switch">
                <input type="checkbox" checked="@SettingsService.BudgetsEnabled" @onchange="OnBudgetsToggled" />
                <span class="toggle-slider"></span>
            </label>
        </div>

        <div class="setting-item">
            <div>
                <span class="setting-label">@Localizer["AutoDeleteEventDuration"]</span>
                <span class="setting-description" style="display: block; margin-top: 2px;">@Localizer["AutoDeleteEventDurationDesc"]</span>
            </div>
            <div style="display: flex; flex-direction: column; align-items: flex-end;">
                <input type="number"
                       class="edit-input @(isAutoDeleteInvalid ? "invalid" : "")"
                       value="@SettingsService.AutoDeleteEventDuration"
                       @oninput="OnAutoDeleteEventDurationChanged"
                       min="0" max="999" step="1"
                       style="width: 80px; text-align: center;" />
                @if (isAutoDeleteInvalid)
                {
                    <span class="edit-error" style="margin-top: 4px; padding: 2px 4px; font-size: 10px;">0-999</span>
                }
            </div>
        </div>

        <div class="setting-item">
            <div>
                <span class="setting-label">@Localizer["StickyEventsDuration"]</span>
                <span class="setting-description" style="display: block; margin-top: 2px;">@Localizer["StickyEventsDurationDesc"]</span>
            </div>
            <div style="display: flex; flex-direction: column; align-items: flex-end;">
                <input type="number"
                       class="edit-input @(isStickyEventsInvalid ? "invalid" : "")"
                       value="@SettingsService.StickyEventsDuration"
                       @oninput="OnStickyEventsDurationChanged"
                       min="0" max="999" step="1"
                       style="width: 80px; text-align: center;" />
                @if (isStickyEventsInvalid)
                {
                    <span class="edit-error" style="margin-top: 4px; padding: 2px 4px; font-size: 10px;">0-999</span>
                }
            </div>
        </div>
    </div>
    }

    @if (SettingsService.TimeularSettingsEnabled)
    {
        <div class="settings-section" id="timeular-section">
            <h2 class="section-title">🧊 @Localizer["SettingsTimeular"]</h2>
            <p class="setting-description">@Localizer["TimeularDescription"]</p>

            @if (!string.IsNullOrWhiteSpace(TimeularService.DeviceName))
            {
                <div class="timeular-device-info">
                    <span class="info-icon">📶</span>
                    <span>@string.Format(Localizer["SelectedDevice"], TimeularService.DeviceName)</span>
                </div>
            }

            <div class="timeular-actions">
                @if (!TimeularService.IsConnected)
                {
                    <button class="sync-button timeular-connect-btn" @onclick="ConnectTimeularDevice" disabled="@TimeularService.IsConnecting">
                        <span class="btn-icon">🔗</span>
                        <span>@(TimeularService.IsConnecting ? Localizer["Connecting"].Value : (TimeularService.HasConnectedBefore ? Localizer["ReconnectTimeular"].Value : Localizer["ConnectTimeular"].Value))</span>
                    </button>
                }
                else
                {
                    <button class="sync-button timeular-connect-btn" @onclick="DisconnectTimeularDevice">
                        <span class="btn-icon">🔌</span>
                        <span>@Localizer["Disconnect"]</span>
                    </button>
                }
            </div>

            @if (!string.IsNullOrWhiteSpace(TimeularService.StatusMessage))
            {
                <div class="status-message @TimeularService.StatusClass">
                    @TimeularService.StatusMessage
                    @if (TimeularService.IsConnected && TimeularService.BatteryLevel.HasValue)
                    {
                        <text> (@(TimeularService.BatteryLevel.Value)%)</text>
                    }
                </div>
            }

            @if (TimeularService.ChangeLog.Count > 0)
            {
                <details class="timeular-log">
                    <summary class="timeular-log-title">@Localizer["RecentDeviceChanges"]</summary>
                    <ul class="timeular-log-list">
                        @foreach (var entry in TimeularService.ChangeLog)
                        {
                            <li class="timeular-log-item">
                                <span class="timeular-log-time">@entry.At.ToLocalTime().ToString("HH:mm:ss")</span>
                                <span class="timeular-log-text">@entry.Message</span>
                            </li>
                        }
                    </ul>
                </details>
            }
        </div>
    }

    @if (SettingsService.ActivityGroupsEnabled)
    {
        <div class="settings-section">
            <h2 class="section-title">🗂️ @Localizer["ActivityGroups"]</h2>

            @for (var groupId = 0; groupId < SettingsService.ActivityGroupCount; groupId++)
            {
                <div class="setting-item">
                    <div>
                        <input class="edit-input"
                               style="min-width: 220px;"
                               value="@GetGroupDisplayName(groupId)"
                               @onchange="@(e => RenameActivityGroup(groupId, e.Value?.ToString()))" />
                       <div style="display: flex; gap: 8px; align-items: center; margin-top: 6px;">
                        @{ var currentGroupId = groupId; }
                        <button id="@($"edit-group-emoji-{currentGroupId}")"
                            type="button"
                            class="edit-input"
                            style="width: 72px; text-align: center; cursor: pointer; padding: 0; background-color: var(--color-surface);"
                            @onclick='@(() => ShowEmojiPicker($"edit-group-emoji-{currentGroupId}", currentGroupId))'>
                            @(GetGroupIcon(currentGroupId))
                        </button>
                        <input class="edit-input"
                            type="color"
                            style="width: 44px; padding: 0;"
                            value="@GetGroupColor(currentGroupId)"
                            @onchange="@(e => UpdateGroupColor(currentGroupId, e.Value?.ToString()))" />
                       </div>
                        <span class="setting-description" style="display: block; margin-top: 2px;">@GetGroupActivitiesCount(groupId) @Localizer["Activities"]</span>
                    </div>
                    <button class="activity-action-btn delete"
                            title="@Localizer["Delete"]"
                            disabled="@(SettingsService.ActivityGroupCount <= 1)"
                            @onclick="@(() => RemoveActivityGroup(groupId))">
                        🗑️
                    </button>
                </div>
            }

            <button class="sync-button tutorial-btn" @onclick="AddActivityGroup">
                <span class="btn-icon">+</span>
                <span>@GetAddGroupLabel()</span>
            </button>
        </div>
    }

    @if (SettingsService.BudgetsEnabled)
    {
        <div class="settings-section">
            <h2 class="section-title">💰 @Localizer["SettingsBudgets"]</h2>

            <div class="setting-item">
                <div>
                    <span class="setting-label">@Localizer["BudgetSettingsNotificationsEnabled"]</span>
                    <span class="setting-description" style="display: block; margin-top: 2px;">@Localizer["BudgetSettingsNotificationsEnabledDesc"]</span>
                </div>
                <label class="toggle-switch">
                    <input type="checkbox" checked="@BudgetSettingsService.NotificationsEnabled" @onchange="OnBudgetNotificationsEnabledToggled" />
                    <span class="toggle-slider"></span>
                </label>
            </div>

            <div class="setting-item">
                <div>
                    <span class="setting-label">@Localizer["BudgetSettingsMinEnabled"]</span>
                    <span class="setting-description" style="display: block; margin-top: 2px;">@Localizer["BudgetSettingsMinEnabledDesc"]</span>
                </div>
                <label class="toggle-switch">
                    <input type="checkbox" checked="@BudgetSettingsService.MinimumEnabled" @onchange="OnBudgetMinEnabledToggled" />
                    <span class="toggle-slider"></span>
                </label>
            </div>

            <div class="setting-item">
                <div>
                    <span class="setting-label">@Localizer["BudgetSettingsThreshold"]</span>
                    <span class="setting-description" style="display: block; margin-top: 2px;">@Localizer["BudgetSettingsThresholdDesc"]</span>
                </div>
                <div class="budget-threshold-input-group">
                    <input type="number" min="75" max="99" value="@BudgetSettingsService.Threshold" @onchange="OnBudgetThresholdChanged" class="edit-input" style="width: 80px; text-align: center;" />
                    <span class="setting-value-suffix">%</span>
                </div>
            </div>

            <div class="setting-item">
                <div>
                    <span class="setting-label">@Localizer["BudgetSettingsBudgetType"]</span>
                    <span class="setting-description" style="display: block; margin-top: 2px;">@Localizer["BudgetSettingsBudgetTypeDesc"]</span>
                </div>
                <select value="@((int)BudgetSettingsService.BudgetType)" @onchange="OnBudgetTypeChanged" class="edit-input">
                    <option value="0">@Localizer["BudgetSettingsBudgetTypeMonthly"]</option>
                    <option value="1">@Localizer["BudgetSettingsBudgetTypeWeekly"]</option>
                    <option value="2">@Localizer["BudgetSettingsBudgetTypeDaily"]</option>
                </select>
            </div>

            <div class="setting-item budget-color-setting">
                <span class="setting-label budget-color-title">@Localizer["Color"]</span>

                <div class="budget-color-grid">
                    <div class="budget-color-card">
                        <span class="budget-color-label">@Localizer["BudgetSettingsColorMinNotReached"]</span>
                        <div class="budget-color-picker-row">
                            <input class="budget-color-input" type="color" value="@BudgetSettingsService.ColorMinimumNotReached" @onchange="OnBudgetColorMinNotReachedChanged" />
                            <span class="budget-color-value">@DisplayColor(BudgetSettingsService.ColorMinimumNotReached)</span>
                        </div>
                    </div>

                    <div class="budget-color-card">
                        <span class="budget-color-label">@Localizer["BudgetSettingsColorMinReachedMaxNotReached"]</span>
                        <div class="budget-color-picker-row">
                            <input class="budget-color-input" type="color" value="@BudgetSettingsService.ColorMinimumReachedMaxNotReached" @onchange="OnBudgetColorMinReachedMaxNotReachedChanged" />
                            <span class="budget-color-value">@DisplayColor(BudgetSettingsService.ColorMinimumReachedMaxNotReached)</span>
                        </div>
                    </div>

                    <div class="budget-color-card">
                        <span class="budget-color-label">@Localizer["BudgetSettingsColorBetweenThresholdMax"]</span>
                        <div class="budget-color-picker-row">
                            <input class="budget-color-input" type="color" value="@BudgetSettingsService.ColorBetweenThresholdMax" @onchange="OnBudgetColorBetweenThresholdMaxChanged" />
                            <span class="budget-color-value">@DisplayColor(BudgetSettingsService.ColorBetweenThresholdMax)</span>
                        </div>
                    </div>

                    <div class="budget-color-card">
                        <span class="budget-color-label">@Localizer["BudgetSettingsColorOverMax"]</span>
                        <div class="budget-color-picker-row">
                            <input class="budget-color-input" type="color" value="@BudgetSettingsService.ColorOverMax" @onchange="OnBudgetColorOverMaxChanged" />
                            <span class="budget-color-value">@DisplayColor(BudgetSettingsService.ColorOverMax)</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }

    <div class="settings-section">
        <h2 class="section-title">👤 @Localizer["SettingsAccount"]</h2>
        @if (AuthService.IsAuthenticated)
        {
            <div class="setting-item">
                <span class="setting-label">@string.Format(Localizer["SignedInAs"], AuthService.CurrentUserEmail)</span>
            </div>
            @if (SettingsService.LastSupabaseSync.HasValue)
            {
                <div class="setting-item">
                    <span class="setting-description">@GetLastSyncText()</span>
                </div>
            }
            <button class="sync-button tutorial-btn" @onclick="RestartTutorialAsync">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M3 12a9 9 0 1 0 9-9 9.75 9.75 0 0 0-6.74 2.74L3 8" />
                    <path d="M3 3v5h5" />
                </svg>
                <span>@Localizer["RestartTutorial"]</span>
            </button>
            <button class="sync-button signout-btn" @onclick="SignOutAsync">
                <span class="btn-icon">↩️</span>
                <span>@Localizer["SignOut"]</span>
            </button>
        }
        else
        {
            <p class="setting-description">@Localizer["SupabaseDesc"]</p>
            <button class="sync-button tutorial-btn" @onclick="RestartTutorialAsync">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M3 12a9 9 0 1 0 9-9 9.75 9.75 0 0 0-6.74 2.74L3 8" />
                    <path d="M3 3v5h5" />
                </svg>
                <span>@Localizer["RestartTutorial"]</span>
            </button>
        }
    </div>

    <div class="settings-section">
        <h2 class="section-title">ℹ️ @Localizer["About"]</h2>
        <div class="setting-item">
            <span class="setting-label">@Localizer["Version"]</span>
            <span class="setting-value">@ApplicationVersion</span>
        </div>
        <div class="setting-item">
            <span class="setting-label">@Localizer["Changelog"]</span>
            <a href="https://github.com/marsop/kairos/blob/master/CHANGELOG.md" target="_blank" class="setting-link">@Localizer["ViewOnGitHub"]</a>
        </div>
    </div>

    <div class="settings-section">
        <h2 class="section-title">❤️ @Localizer["Support"]</h2>
        <p class="setting-description">@Localizer["SupportDesc"]</p>
        <button class="support-btn" @onclick="OpenBuyMeACoffee">
            <span class="btn-icon">☕</span>
            <span>@Localizer["BuyMeACoffee"]</span>
        </button>
    </div>

    <Kairos.App.Components.ConfirmationDialog
        IsVisible="@showConfirmation1"
        Title="@Localizer["FactoryReset"]"
        Message="@Localizer["PromptReset"]"
        OnClose="OnConfirm1" />

    <Kairos.App.Components.ConfirmationDialog
        IsVisible="@showConfirmation2"
        Title="@Localizer["FinalWarning"]"
        Message="@Localizer["FinalWarningMsg"]"
        OnClose="OnConfirm2" />

    <div class="settings-section danger-zone">
        <h2 class="section-title">⚠️ @Localizer["FactoryReset"]</h2>
        <p class="setting-description">@Localizer["FactoryResetDesc"]</p>
        <button class="reset-btn" @onclick="RequestReset">
            <span class="btn-icon">⚠️</span>
            <span>@Localizer["ResetApp"]</span>
        </button>
    </div>
</div>

@code {
    private DotNetObjectReference<Settings>? _objRef;
    private int? _editingGroupId;
    private bool isDropdownOpen;
    private bool isThemeDropdownOpen;
    private bool isAvatarDropdownOpen;
    private bool showConfirmation1;
    private bool showConfirmation2;
    private bool browserNotificationsDenied;
    private bool isAutoDeleteInvalid;
    private bool isStickyEventsInvalid;

    private static string ApplicationVersion
    {
        get
        {
            var version = typeof(Settings)
                .Assembly
                .GetCustomAttribute<AssemblyInformationalVersionAttribute>()
                ?.InformationalVersion
            ?? typeof(Settings).Assembly.GetName().Version?.ToString()
            ?? "unknown";

            var plusIndex = version.IndexOf('+');
            return plusIndex >= 0 ? version[..plusIndex] : version;
        }
    }

    private string SelectedLanguage => SettingsService.Language;
    private string SelectedTheme => SettingsService.Theme;

    private record LanguageOption(string Name, string Code, RenderFragment Flag);
    private record ThemeOption(string LabelKey, string Code, RenderFragment Icon);

    private static readonly RenderFragment FlagEn = @<svg viewBox="0 0 640 480"><rect width="640" height="480" fill="#012169"/><path d="M75 0l245 180L565 0h75v60L395 240l245 180v60h-75L320 300 75 480H0v-60l245-180L0 60V0h75z" fill="#fff"/><path d="M424 281l216 159v40L369 281h55zM216 199L0 41v40l161 118h55zm0 82L0 439v40l216-159v-40zm208-82l216-159V41L424 199h0z" fill="#C8102E"/><path d="M240 0v480h160V0H240zM0 160v160h640V160H0z" fill="#fff"/><path d="M280 0v480h80V0h-80zM0 200v80h640v-80H0z" fill="#C8102E"/></svg>;
    private static readonly RenderFragment FlagDe = @<svg viewBox="0 0 5 3"><rect width="5" height="3" y="0" fill="#000"/><rect width="5" height="2" y="1" fill="#D00"/><rect width="5" height="1" y="2" fill="#FFCE00"/></svg>;
    private static readonly RenderFragment FlagEs = @<svg viewBox="0 0 750 500"><rect width="750" height="500" fill="#c60b1e"/><rect width="750" height="250" y="125" fill="#ffc400"/><path d="M120 150 a60 60 0 0 0 0 120 v30 a30 30 0 0 0 60 0 v-30 a60 60 0 0 0 0 -120 z" fill="#c60b1e" opacity="0.5"/></svg>;
    private static readonly RenderFragment FlagGl = @<svg viewBox="0 0 3 2"><rect width="3" height="2" fill="#fff"/><path d="M0 2L3 0" stroke="#009edb" stroke-width="0.4"/></svg>;
    private static readonly RenderFragment FlagVo = @<svg viewBox="0 0 2 1"><rect width="2" height="1" fill="#fff"/><rect width="2" height="0.5" y="0.5" fill="#f00"/></svg>;

    private static readonly RenderFragment IconLight = @<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="5"></circle><line x1="12" y1="1" x2="12" y2="3"></line><line x1="12" y1="21" x2="12" y2="23"></line><line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"></line><line x1="1" y1="12" x2="3" y2="12"></line><line x1="21" y1="12" x2="23" y2="12"></line><line x1="4.22" y1="19.78" x2="5.64" y2="18.36"></line><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"></line></svg>;
    private static readonly RenderFragment IconDark = @<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path></svg>;

    private List<LanguageOption> Languages = new()
    {
        new("English", "en", FlagEn),
        new("Deutsch", "de", FlagDe),
        new("Español", "es", FlagEs),
        new("Galego", "gl", FlagGl),
        new("Vorarlbergerisch", "gsw", FlagVo)
    };
    private List<ThemeOption> Themes = new()
    {
        new("ThemeLight", "light", IconLight),
        new("ThemeDark", "dark", IconDark)
    };

    private string GetLanguageName(string code) => Languages.FirstOrDefault(l => l.Code == code)?.Name ?? "English";
    private RenderFragment GetFlag(string code) => Languages.FirstOrDefault(l => l.Code == code)?.Flag ?? FlagEn;
    private string GetThemeName(string code)
    {
        var labelKey = Themes.FirstOrDefault(t => t.Code == code)?.LabelKey ?? "ThemeLight";
        return Localizer[labelKey];
    }
    private RenderFragment GetThemeIcon(string code) => Themes.FirstOrDefault(t => t.Code == code)?.Icon ?? IconLight;

    protected override void OnInitialized()
    {
        SettingsService.OnSettingsChanged += StateHasChanged;
        TutorialService.OnChange += StateHasChanged;
        TimeularService.OnStateChanged += OnTimeularStateChanged;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await TimeularService.InitializeAsync();
        }
    }

    public void Dispose()
    {
        SettingsService.OnSettingsChanged -= StateHasChanged;
        TutorialService.OnChange -= StateHasChanged;
        TimeularService.OnStateChanged -= OnTimeularStateChanged;
        _objRef?.Dispose();
    }

    private void ToggleDropdown() => isDropdownOpen = !isDropdownOpen;

    private async Task SelectLanguage(string code)
    {
        if (SelectedLanguage == code)
        {
            isDropdownOpen = false;
            return;
        }

        await SettingsService.SetLanguageAsync(code);
        isDropdownOpen = false;
        NavigationManager.NavigateTo(NavigationManager.Uri, forceLoad: true);
    }

