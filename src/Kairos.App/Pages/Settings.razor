    private void AddActivityGroup()
    {
        var newGroupId = SettingsService.ActivityGroupCount;
        SettingsService.ActivityGroupCount += 1;
        SettingsService.SetActivityGroupName(newGroupId, string.Format(Localizer["Group"], DateTime.Now.ToString("yyyy-MM-dd")));
        SettingsService.SetActivityGroupColor(newGroupId, "#10B981");
        SettingsService.SetActivityGroupIcon(newGroupId, "🗂️");
        SettingsService.ActiveActivityGroup = SettingsService.ActivityGroupCount - 1;
        StateHasChanged();
    }

    private string GetAddGroupLabel()
    {
        return $"+ {Localizer["Group", string.Empty].Value.Trim()}";
    }

    private void RemoveActivityGroup(int groupId)
    {
        if (SettingsService.ActivityGroupCount <= 1)
        {
            return;
        }

        TimeService.RemoveActivityGroup(groupId);
        SettingsService.RemoveActivityGroupNameAt(groupId);
        SettingsService.ActivityGroupCount -= 1;

        if (SettingsService.ActiveActivityGroup > groupId)
        {
            SettingsService.ActiveActivityGroup -= 1;
        }
        else if (SettingsService.ActiveActivityGroup >= SettingsService.ActivityGroupCount)
        {
            SettingsService.ActiveActivityGroup = SettingsService.ActivityGroupCount - 1;
        }

        StateHasChanged();
    }

    private async Task OnBrowserNotificationsToggled(ChangeEventArgs e)
    {
        var enabled = (bool)(e.Value ?? false);

        if (enabled)
        {
            var permission = await NotificationService.RequestBrowserPermissionAsync();
            if (permission == "granted")
            {
                SettingsService.BrowserNotificationsEnabled = true;
                browserNotificationsDenied = false;
            }
            else
            {
                SettingsService.BrowserNotificationsEnabled = false;
                browserNotificationsDenied = permission == "denied";
            }
        }
        else
        {
            SettingsService.BrowserNotificationsEnabled = false;
            browserNotificationsDenied = false;
        }

        StateHasChanged();
    }

